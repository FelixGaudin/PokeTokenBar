# Copy to .env and adjust. Every value has a working default.

# Host port the app is served on.
PTB_PORT=8420

# Must match the owner of ~/.claude — run `id -u` and `id -g`.
PTB_UID=1000
PTB_GID=1000

# Your local timezone. Decides which tokens count toward "today".
PTB_TZ=Europe/Brussels

# Seconds between log re-scans.
PTB_POLL_INTERVAL=60

# Official 5-hour / weekly limit percentages from api.anthropic.com.
# Set to 0 to skip the credential read and stay fully local.
PTB_LIMITS_ENABLED=1
PTB_LIMITS_INTERVAL=300

# Where your Claude config lives. Optional — defaults to ~/.claude.
# The app runs fine without a real one; it simply reports that it found no logs.
# Point this at an empty directory to run with no access to your Claude config.
# PTB_CLAUDE_DIR=/home/you/.config/claude

# Extra Claude accounts are mounted in docker-compose.yml under /host/accounts; to list
# them explicitly instead (optionally labelled), set e.g.
# PTB_CLAUDE_ACCOUNT_DIRS=work=/host/accounts/.claude-work
