# Copy to .env and adjust. Every value has a working default.

# Host port the app is served on.
PTB_PORT=8420

# Must match the owner of ~/.claude — run `id -u` and `id -g`.
PTB_UID=1000
PTB_GID=1000

# Your local timezone. Decides which tokens count toward "today".
PTB_TZ=Europe/Brussels

# Seconds between log re-scans.
PTB_POLL_INTERVAL=60

# Official 5-hour / weekly limit percentages from api.anthropic.com.
# Set to 0 to skip the credential read and stay fully local.
PTB_LIMITS_ENABLED=1
PTB_LIMITS_INTERVAL=300

# Optional: supply the OAuth access token yourself instead of having the
# container read ~/.claude/.credentials.json. Get it on the host with:
#   python3 -c "import json,os;print(json.load(open(os.path.expanduser('~/.claude/.credentials.json')))['claudeAiOauth']['accessToken'])"
# Note it expires, so you would need to re-paste it periodically. Reading the
# mounted file picks up refreshes automatically, which is why that is the default.
# PTB_OAUTH_TOKEN=sk-ant-oat01-...

# Only if your Claude config lives somewhere other than ~/.claude.
# PTB_CLAUDE_DIR=/home/you/.config/claude
